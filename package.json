{
  "name": "@buttercup/importer",
  "version": "3.1.0",
  "description": "Buttercup archive importer for other password manager archives",
  "main": "source/index.js",
  "scripts": {
    "docs": "jsdoc2md 'source/**/*.js' > API.md",
    "format": "prettier --write '{source,test}/**/*.js'",
    "test": "run-s test:specs test:format",
    "test:format": "prettier --check '{source,test}/**/*.js'",
    "test:specs": "c8 --reporter=text-summary mocha -r test/index.js 'test/specs/**/*.spec.js'"
  },
  "files": [
    "source/**/*.js",
    "*.md"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "{source,test}/**/*.js": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buttercup/buttercup-importer.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "keywords": [
    "buttercup",
    "keepass",
    "import",
    "lastpass",
    "1password",
    "password",
    "bitwarden"
  ],
  "author": "Perry Mitchell <perry@perrymitchell.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/buttercup/buttercup-importer/issues"
  },
  "homepage": "https://github.com/buttercup/buttercup-importer#readme",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "layerr": "^1.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@buttercup/exporter": "git+http://192.168.168.6:3050/buttercup.codekunde/buttercup-exporter.git#master",
    "buttercup": "git+http://192.168.168.6:3050/buttercup.codekunde/buttercup-core.git#master",
    "c8": "^12.0.0",
    "chai": "^4.3.7",
    "husky": "^4.3.8",
    "jsdoc-to-markdown": "^9.1.3",
    "lint-staged": "^16.4.0",
    "mocha": "^12.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "sinon": "^22.1.0"
  },
  "peerDependencies": {
    "buttercup": ">= 6"
  }
}
