{
  "name": "@buttercup/importer",
  "version": "3.1.0",
  "description": "Buttercup archive importer for other password manager archives",
  "main": "source/index.js",
  "scripts": {
    "docs": "npx --yes jsdoc-to-markdown 'source/**/*.js' > API.md",
    "format": "prettier --write '{source,test}/**/*.js'",
    "test": "run-s test:specs test:format",
    "test:format": "prettier --check '{source,test}/**/*.js'",
    "test:specs": "c8 --reporter=text-summary mocha -r test/index.js 'test/specs/**/*.spec.js'"
  },
  "files": [
    "source/**/*.js",
    "*.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buttercup-fork/buttercup-importer.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "keywords": [
    "buttercup",
    "keepass",
    "import",
    "lastpass",
    "1password",
    "password",
    "bitwarden"
  ],
  "author": "Perry Mitchell <perry@perrymitchell.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/buttercup-fork/buttercup-importer/issues"
  },
  "homepage": "https://github.com/buttercup-fork/buttercup-importer#readme",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "layerr": "^1.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@buttercup/exporter": "git+https://github.com/buttercup-fork/buttercup-exporter.git#master",
    "buttercup": "git+https://github.com/buttercup-fork/buttercup-core.git#master",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "sinon": "^22.1.0"
  },
  "peerDependencies": {
    "buttercup": ">= 6"
  }
}
